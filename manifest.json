{
    "manifest_version": 2,
    "id": "zbx-impersonate",
    "name": "Impersonate",
    "version": "1.1.0",
    "namespace": "ZbxImpersonate",
    "author": "Rafael M. A. Leão Ereno - MALE",
    "description": "Permite que Super Admins assumam a sessao de outros usuarios do Zabbix (login as) com trava de somente-leitura, expiracao automatica e log de auditoria.",
    "url": "https://github.com/leaoereno/module-zbx-inpersonate",
    "icon": "",
    "config": {
        "session_ttl": 1800,
        "readonly": 1,
        "block_super_admin_target": 1,
        "require_module_access": 1
    },
    "actions": {
        "zbx.impersonate.list": {
            "class": "ImpersonateList",
            "layout": "layout.htmlpage",
            "view": "zbx.impersonate.list"
        },
        "zbx.impersonate.profile": {
            "class": "ImpersonateProfile",
            "layout": "layout.json",
            "view": "zbx.impersonate.profile"
        },
        "zbx.impersonate.start": {
            "class": "ImpersonateStart",
            "layout": "layout.json",
            "view": "zbx.impersonate.start"
        },
        "zbx.impersonate.stop": {
            "class": "ImpersonateStop",
            "layout": "layout.htmlpage",
            "view": "zbx.impersonate.stop"
        },
        "zbx.impersonate.log": {
            "class": "ImpersonateLog",
            "layout": "layout.htmlpage",
            "view": "zbx.impersonate.log"
        },
        "zbx.impersonate.grant": {
            "class": "ImpersonateGrant",
            "layout": "layout.json",
            "view": "zbx.impersonate.grant"
        }
    }
}
